{
  "manifest_version": 3,
  "name": "Browser Monitor",
  "version": "1.1.4",
  "minimum_chrome_version": "120",
  "description": "Analyzes Chrome tabs and provides local ad, tracker, distraction, cookie-banner, and custom element controls.",
  "icons": {
    "16": "icons/browser-monitor-16.png",
    "32": "icons/browser-monitor-32.png",
    "48": "icons/browser-monitor-48.png",
    "128": "icons/browser-monitor-128.png"
  },
  "permissions": [
    "alarms",
    "contextMenus",
    "declarativeNetRequest",
    "favicon",
    "scripting",
    "storage",
    "tabs",
    "webNavigation",
    "webRequest"
  ],
  "optional_permissions": [
    "browsingData",
    "bookmarks",
    "clipboardWrite",
    "cookies",
    "downloads",
    "history"
  ],
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "core/service-worker.js",
    "type": "module"
  },
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "easylist",
        "enabled": true,
        "path": "rules/easylist-network.json"
      },
      {
        "id": "easyprivacy",
        "enabled": true,
        "path": "rules/easyprivacy-network.json"
      },
      {
        "id": "ruadlist",
        "enabled": true,
        "path": "rules/ruadlist-network.json"
      }
    ]
  },
  "action": {
    "default_title": "Browser Monitor",
    "default_popup": "ui/popup/popup.html",
    "default_icon": {
      "16": "icons/browser-monitor-toolbar-16.png",
      "32": "icons/browser-monitor-toolbar-32.png"
    }
  },
  "options_ui": {
    "page": "ui/options/options.html",
    "open_in_tab": true
  },
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "features/security/page-guard.js",
        "core/content.js"
      ],
      "run_at": "document_start",
      "all_frames": false
    },
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "features/security/page-guard.js",
        "features/tools/video-resume-frame.js"
      ],
      "run_at": "document_start",
      "all_frames": true
    },
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "features/analytics/frame-metrics.js"
      ],
      "run_at": "document_start",
      "all_frames": true
    },
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "features/security/crypto-guard-main.js"
      ],
      "run_at": "document_start",
      "all_frames": false,
      "world": "MAIN"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "images/image-swap-*.svg",
        "icons/browser-monitor-core.svg"
      ],
      "matches": [
        "http://*/*",
        "https://*/*"
      ]
    }
  ]
}
